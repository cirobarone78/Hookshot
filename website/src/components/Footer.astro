  <nav aria-label="Footer"><a href={`${base}about/`}>About this preview</a><a href="https://github.com/NotRexed/Hookshot/issues/new/choose">Report a bug ↗</a><a href="https://github.com/NotRexed/Hookshot">Source ↗</a></nav>
